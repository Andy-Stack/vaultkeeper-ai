{
	"name": "vaultkeeper-ai",
	"version": "1.0.0",
	"description": "AI powered agent assistant.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"svelte-check": "svelte-check --tsconfig tsconfig.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:efforts": "esbuild __tests__/Live/TestModelEfforts.ts --bundle --platform=node --format=esm --log-level=warning | node --input-type=module"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
		"@eslint/js": "^10.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"@types/path-browserify": "^1.0.3",
		"@typescript-eslint/eslint-plugin": "8.72.0",
		"@typescript-eslint/parser": "8.72.0",
		"@vitest/ui": "^5.0.5",
		"esbuild": "^0.28.2",
		"esbuild-svelte": "^0.9.5",
		"eslint": "^10.13.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"happy-dom": "^21.0.4",
		"obsidian": "latest",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-preprocess": "^6.0.5",
		"tslib": "2.8.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5",
		"yaml": "^2.9.1"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.136.0",
		"@eslint-community/regexpp": "^4.12.2",
		"@google/genai": "^2.30.0",
		"@shikijs/rehype": "^4.5.0",
		"core-js": "^3.51.0",
		"diff": "^9.0.0",
		"diff2html": "^3.4.56",
		"express": "^5.3.0",
		"fflate": "^0.8.3",
		"fuzzysort": "^4.0.2",
		"highlight.js": "^11.12.0",
		"katex": "^0.19.0",
		"lowlight": "^3.3.0",
		"openai": "^7.39.0",
		"path-browserify": "^1.0.1",
		"redos-detector": "^6.1.4",
		"regex-parser": "^2.3.1",
		"uuid": "^14.0.3",
		"zod": "^4.6.7"
	}
}
